---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume / CV | Aaron Kyle Villegas" sideBarActiveItemID="cv">
  <!-- Prominent Download Resume Button & Profile Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-base-300">
    <div>
      <div class="text-3xl font-extrabold tracking-tight">Aaron Kyle Villegas</div>
      <div class="text-sm font-semibold text-primary mt-1">Data Analyst | Business Intelligence | SQL, Python</div>
    </div>
    <a 
      href="/Resume.pdf" 
      target="_blank" 
      download="Aaron_Kyle_Villegas_Resume.pdf"
      class="btn btn-primary gap-2 shadow-md hover:shadow-lg transition-all hover:scale-105"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
        <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
        <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
      </svg>
      <span>Download Official PDF Resume</span>
    </a>
  </div>

  <div class="mb-10 text-justify text-base leading-relaxed">
    Applied Mathematics graduate specializing in data analytics, business intelligence, ETL processes, and KPI reporting to uncover actionable retail trends. Highly skilled in translating complex data into business strategies using SQL, Python, and Tableau. Based in Bentonville, Arkansas.
  </div>

  <!-- Education -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Bachelor of Science in Applied and Computational Mathematics (Specialization in Data Science)"
      subtitle="Graduated June 2026 at University of California, Irvine — Irvine, CA"
    >
      <p class="font-semibold text-sm mb-1 text-primary">GPA: 3.91 | Dean's Honor List | Recipient of Howard Tucker Award in Mathematics | Cum Laude</p>
    </TimeLineElement>
  </div>

  <!-- Relevant Experience -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Relevant Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="AI Benchmark Engineering Fellow"
      subtitle="July 2026 at Handshake AI — Remote"
    >
      <ul class="list-disc ml-4 text-sm grid gap-1.5">
        <li>Developed robust testing frameworks to identify data anomalies (e.g., time zone shifts, unit glitches), ensuring the integrity of downstream ETL pipelines and executive BI reports.</li>
        <li>Developed an automated Python verification suite utilizing statistical analysis to evaluate data accuracy and maintain strict reporting tolerances.</li>
      </ul>
    </TimeLineElement>

    <TimeLineElement
      title="Jane Street Summer Program Student — Quantitative Finance / Trading"
      subtitle="June 2023 to July 2023 at Jane Street — NYC"
    >
      <ul class="list-disc ml-4 text-sm grid gap-1.5">
        <li>Selected for competitive quantitative finance program; developed and optimized a Python-based trading strategy with a team in a simulated environment, finishing in the top 25%.</li>
      </ul>
    </TimeLineElement>
  </div>

  <!-- Data Analytics Projects Section -->
  <div class="mb-5">
    <div class="flex justify-between items-end border-b pb-2">
      <div class="text-3xl font-bold">Data Analytics Projects</div>
      <a href="/projects" class="text-sm text-primary hover:underline font-semibold">View All Projects & Demos →</a>
    </div>
  </div>

  <div class="grid gap-4 mb-10 text-sm">
    <!-- 1. Walmart Retail Sales -->
    <div class="p-4 bg-base-200 rounded-lg border border-base-300">
      <div class="flex justify-between items-start flex-wrap gap-2">
        <div class="font-bold text-base">
          <a href="/blog/walmart-sales" class="hover:underline text-primary">
            Walmart Retail Sales & Inventory Strategy Analysis ↗
          </a>
        </div>
        <span class="text-xs text-base-content/70">April 2026</span>
      </div>
      <ul class="list-disc ml-4 text-xs text-base-content/80 mt-2 grid gap-1">
        <li>Developed automated reporting models using Python and SQL to evaluate business KPIs across retail locations, translating raw data into insights that uncovered a 69% holiday sales lift and identified top 20% revenue-driving stores.</li>
        <li>Analyzed store-level demand volatility to track consumer purchasing patterns, recommending flexible inventory and supply chain strategies for volatile locations.</li>
        <li>Designed Tableau dashboard tracking 9+ core business KPIs (YoY growth, demand variability, 30-day rolling average, store rankings) to directly support executive inventory planning and staffing decisions.</li>
      </ul>
      <div class="flex flex-wrap gap-1 mt-3">
        <span class="badge badge-outline badge-xs">Python</span>
        <span class="badge badge-outline badge-xs">SQL</span>
        <span class="badge badge-outline badge-xs">Tableau</span>
        <span class="badge badge-outline badge-xs">Pandas</span>
      </div>
    </div>

    <!-- 2. Environmental Health Risk Mapping Platform -->
    <div class="p-4 bg-base-200 rounded-lg border border-base-300">
      <div class="flex justify-between items-start flex-wrap gap-2">
        <div class="font-bold text-base">
          <a href="/blog/environmental-health-risk-map" class="hover:underline text-primary">
            Environmental Health Risk Mapping Platform ↗
          </a>
          <span class="badge badge-sm badge-secondary ml-2">Datathon Winner</span>
        </div>
        <span class="text-xs text-base-content/70">April 2026</span>
      </div>
      <ul class="list-disc ml-4 text-xs text-base-content/80 mt-2 grid gap-1">
        <li>Won "Best Visualization" out of 39 teams with an interactive dashboard that predicted asthma and cardiovascular risks.</li>
        <li>Aggregated and cleaned public health data from 8,000+ census tracts (700+ ZIP codes) using Python, engineering a Health Vulnerability Index (HVI) that combined pollution and socioeconomic factors.</li>
        <li>Applied XGBoost machine learning models to identify key predictors of health risks.</li>
      </ul>
      <div class="flex flex-wrap gap-1 mt-3">
        <span class="badge badge-outline badge-xs">Python</span>
        <span class="badge badge-outline badge-xs">XGBoost</span>
        <span class="badge badge-outline badge-xs">FastAPI</span>
        <span class="badge badge-outline badge-xs">Spatial Analysis</span>
      </div>
    </div>

    <!-- 3. A/B Testing Analysis -->
    <div class="p-4 bg-base-200 rounded-lg border border-base-300">
      <div class="flex justify-between items-start flex-wrap gap-2">
        <div class="font-bold text-base">
          <a href="/blog/ab-test-marketing-campaign" class="hover:underline text-primary">
            A/B Testing Analysis of Digital Marketing Campaigns ↗
          </a>
        </div>
        <span class="text-xs text-base-content/70">May 2026</span>
      </div>
      <ul class="list-disc ml-4 text-xs text-base-content/80 mt-2 grid gap-1">
        <li>Executed statistical hypothesis testing (two-proportion z-tests, power analysis) on 588K+ users, confirming a statistically significant 0.7% conversion lift (p &lt; 0.05) to guide ad spend allocation.</li>
        <li>Mapped user interaction metrics and conversion funnels in Seaborn/Matplotlib to deliver visual KPIs to marketing leadership.</li>
      </ul>
      <div class="flex flex-wrap gap-1 mt-3">
        <span class="badge badge-outline badge-xs">Python</span>
        <span class="badge badge-outline badge-xs">Pandas</span>
        <span class="badge badge-outline badge-xs">statsmodels</span>
        <span class="badge badge-outline badge-xs">A/B Testing</span>
      </div>
    </div>

    <!-- 4. End-to-end Macro Data Pipeline -->
    <div class="p-4 bg-base-200 rounded-lg border border-base-300">
      <div class="flex justify-between items-start flex-wrap gap-2">
        <div class="font-bold text-base">
          <a href="/blog/macro-data-pipeline" class="hover:underline text-primary">
            End-to-end Macro Data Pipeline ↗
          </a>
        </div>
        <span class="text-xs text-base-content/70">April 2026 – Present</span>
      </div>
      <ul class="list-disc ml-4 text-xs text-base-content/80 mt-2 grid gap-1">
        <li>Designed and built an end-to-end ETL pipeline to source time-series data from FRED and Open-Meteo APIs into PostgreSQL, Snowflake, and BigQuery to support large-scale business intelligence initiatives.</li>
        <li>Executed complex SQL queries to uncover historical trends, calculating rolling averages and year-over-year variances to help stakeholders visualize long-term market impacts.</li>
        <li>Automated ETL data-cleaning and deduplication workflows, reducing integration errors and improving the reliability of datasets used for operational reporting.</li>
      </ul>
      <div class="flex flex-wrap gap-1 mt-3">
        <span class="badge badge-outline badge-xs">Python</span>
        <span class="badge badge-outline badge-xs">PostgreSQL</span>
        <span class="badge badge-outline badge-xs">BigQuery</span>
        <span class="badge badge-outline badge-xs">Snowflake</span>
        <span class="badge badge-outline badge-xs">AWS S3</span>
        <span class="badge badge-outline badge-xs">Linux CLI</span>
      </div>
    </div>
  </div>

  <!-- Employment -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Employment</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Rock Wall Supervisor and Belayer"
      subtitle="April 2024 to June 2026 at UCI Recreation Center — Irvine, CA"
    />

    <TimeLineElement
      title="Student Body Intern"
      subtitle="September 2023 to June 2024 at Associated Students at UCI — Irvine, CA"
    />
  </div>

  <!-- Skills -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills & Technologies</div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10 text-sm">
    <div class="p-4 bg-base-200/60 rounded-lg border border-base-300">
      <h4 class="font-bold border-b pb-1 mb-2 text-primary">Languages & Libraries</h4>
      <ul class="list-disc ml-5 grid gap-1">
        <li><b>Languages:</b> Python, SQL, R, C++</li>
        <li><b>Libraries:</b> Pandas, NumPy</li>
      </ul>
    </div>
    <div class="p-4 bg-base-200/60 rounded-lg border border-base-300">
      <h4 class="font-bold border-b pb-1 mb-2 text-primary">Tools & Infrastructure</h4>
      <ul class="list-disc ml-5 grid gap-1">
        <li>Tableau, PowerBI, BigQuery, Snowflake</li>
        <li>AWS S3, Git, PostgreSQL, Excel, REST API, Linux CLI</li>
      </ul>
    </div>
    <div class="p-4 bg-base-200/60 rounded-lg border border-base-300 md:col-span-2">
      <h4 class="font-bold border-b pb-1 mb-2 text-primary">Methods & Analytical Competencies</h4>
      <ul class="list-disc ml-5 grid gap-1">
        <li>Data Visualization, KPI Tracking, ETL Pipelines, Data Cleaning, Statistical Analysis, A/B Testing</li>
      </ul>
    </div>
  </div>
</BaseLayout>
