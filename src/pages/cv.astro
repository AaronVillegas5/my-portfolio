---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume | Aaron Kyle Villegas" sideBarActiveItemID="cv">
  <!-- Download Resume Button & Profile Header -->
  <div class="flex justify-between items-center mb-5">
    <div class="text-3xl font-bold">Profile</div>
    <a href="/resume.pdf" target="_blank" class="btn btn-outline btn-primary btn-sm md:btn-md">
      📄 Download PDF Resume
    </a>
  </div>

  <div class="mb-10 text-justify">
    Applied Mathematics graduate specializing in data science, predictive modeling, machine learning, and statistical analysis to uncover behavioral trends. Highly skilled in advanced SQL, Python, ETL pipelines, and enterprise visualization to translate complex organizational data into actionable strategies. Relocating to Northwest Arkansas.
  </div>

  <!-- Education -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="B.S. in Applied and Computational Mathematics (Specialization in Data Science)"
      subtitle="2022 to 2026 at University of California, Irvine — Irvine, CA"
    >
      <p class="font-semibold text-sm mb-1">GPA: 3.91 | Cum Laude | Howard Tucker Award in Mathematics | 9x Dean's Honor List</p>
      <p class="text-sm"><b>Relevant Coursework:</b> Mathematical Machine Learning (A+), Optimization I & II (A+), Statistical Methods for Data I & II (A+), Financial Derivatives & Fixed Income (A+), Numerical Analysis, Linear Algebra, Probability</p>
    </TimeLineElement>
  </div>

  <!-- Experience -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="AI Benchmark Engineering Fellow"
      subtitle="June 2026 to July 2026 at Handshake AI (Remote)"
    >
      <ul class="list-disc ml-4 text-sm grid gap-1">
        <li>Engineered a synthetic time-series telemetry dataset to benchmark frontier AI models on advanced Exploratory Data Analysis (EDA) and anomaly detection.</li>
        <li>Programmatically injected overlapping data anomalies (time zone shifts, unit glitches, multi-day thermal drift) to simulate silent ETL pipeline failures.</li>
        <li>Developed an automated Python verification suite using local OLS detrending and nan-median aggregation to evaluate model accuracy within strict statistical tolerances.</li>
      </ul>
    </TimeLineElement>

    <TimeLineElement
      title="Summer Program Student — Quantitative Finance & Trading"
      subtitle="June 2023 to July 2023 at Jane Street — New York, NY"
    >
      <ul class="list-disc ml-4 text-sm grid gap-1">
        <li>Selected for competitive quantitative finance program; developed and optimized a Python-based trading strategy with a team in a simulated environment, finishing in the top 25%.</li>
      </ul>
    </TimeLineElement>

    <TimeLineElement
      title="Rock Wall Supervisor & Belayer"
      subtitle="April 2024 to June 2026 at UCI Recreation Center — Irvine, CA"
    >
      <ul class="list-disc ml-4 text-sm grid gap-1">
        <li>Supervised and trained climbers; optimized scheduling to reduce wait times using check-in data.</li>
      </ul>
    </TimeLineElement>

    <TimeLineElement
      title="Student Body Intern"
      subtitle="September 2023 to June 2024 at Associated Students at UCI — Irvine, CA"
    >
      <ul class="list-disc ml-4 text-sm grid gap-1">
        <li>Coordinated 4+ large-scale speaker events (80–100 attendees) and communicated with 80+ alumni/professionals to ensure diverse, high-impact presentations.</li>
      </ul>
    </TimeLineElement>
  </div>

  <!-- Honors & Awards -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Honors & Awards</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2 text-sm">
    <li><b>Datathon Winner (Best Visualization):</b> Environmental Health Risk Mapping Platform (Out of 39 teams) — <i>April 2026</i></li>
    <li><b>Howard Tucker Award in Mathematics:</b> Outstanding achievement in upper-division math coursework — <i>June 2026</i></li>
    <li><b>Cum Laude & 9x Dean's Honor List:</b> Maintained 3.91 GPA across all quarters at UC Irvine — <i>2022–2026</i></li>
  </ul>

  <!-- Skills -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills & Technologies</div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10 text-sm">
    <div>
      <h4 class="font-bold border-b pb-1 mb-2">Languages & Core</h4>
      <ul class="list-disc ml-5 grid gap-1">
        <li>Python, SQL, R, C++</li>
        <li>Advanced Mathematics & Statistics</li>
      </ul>
    </div>
    <div>
      <h4 class="font-bold border-b pb-1 mb-2">Libraries & Frameworks</h4>
      <ul class="list-disc ml-5 grid gap-1">
        <li>Pandas, NumPy, scikit-learn</li>
        <li>PyTorch, XGBoost, statsmodels</li>
        <li>FastAPI, REST APIs</li>
      </ul>
    </div>
    <div>
      <h4 class="font-bold border-b pb-1 mb-2">Tools & Cloud Infrastructure</h4>
      <ul class="list-disc ml-5 grid gap-1">
        <li>Tableau, PowerBI, Excel</li>
        <li>PostgreSQL, BigQuery, Snowflake</li>
        <li>AWS S3, Docker, Git, Linux CLI</li>
      </ul>
    </div>
    <div>
      <h4 class="font-bold border-b pb-1 mb-2">Methods & Domains</h4>
      <ul class="list-disc ml-5 grid gap-1">
        <li>ETL Data Pipelines, Data Architecture</li>
        <li>Machine Learning & Predictive Modeling</li>
        <li>A/B Testing & Statistical Analysis</li>
      </ul>
    </div>
  </div>
</BaseLayout>