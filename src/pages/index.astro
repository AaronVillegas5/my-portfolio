---
// Home page layout
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && !post.slug.startsWith("post"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1 font-medium">Hello! </div>
    <div class="text-5xl font-bold">I'm Aaron Kyle Villegas</div>
    <div class="text-2xl md:text-3xl py-3 font-bold text-primary leading-snug">
      Data Analyst / Business Intelligence Analyst | Python, SQL, dbt
    </div>
    <div class="py-2">
      <p class="text-lg leading-relaxed">
        I'm an Applied Math grad from UC Irvine, living in Northwest Arkansas. I like turning messy data into something people can act on: pipelines that run on their own, forecasts, and dashboards. Most of my work is in Python and SQL, with a lot of retail and supply chain examples.
      </p>
      <p class="mt-4 flex items-start gap-2 text-base leading-relaxed">
        <img src="/humn-mark.svg" alt="HUMN Solutions logo" class="h-6 w-6 shrink-0 mt-0.5" />
        <span>
          Right now I'm a Software Development Intern at <b>HUMN Solutions</b>, where I build and run
          <a class="link link-primary" href="https://aaronvillegas5.github.io/frontier-brief/" target="_blank" rel="noopener noreferrer">The Frontier Brief</a>, a daily AI newsletter.
        </span>
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="btn btn-primary" href="/Resume.pdf" target="_blank" rel="noopener noreferrer">
        View Resume
      </a>
      <a class="btn btn-outline" href="https://linkedin.com/in/aaronvillegas1" target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
      <a class="btn btn-outline" href="https://github.com/AaronVillegas5" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Featured Projects</div>
  </div>

  <!-- 1. Walmart Sales & Demand Analytics -->
  <HorizontalCard
    title="Walmart Retail Sales & Inventory Strategy Analysis"
    img="/walmart-analytics.webp"
    desc="Retail demand analysis across 45 stores and 2 years of weekly sales. Modeled holiday seasonality (including a 69% Christmas surge) and store-level demand variance (Coefficient of Variation) to spot where safety stock ran thin. Built a Tableau dashboard comparing year-over-year revenue, store tiers, and 30-day rolling sales."
    url="/blog/walmart-sales"
    badge="Retail Analytics"
    tags={["Python", "SQL", "Tableau", "Pandas", "Demand Planning"]}
    custom_links={[
      { text: "Read Case Study", url: "/blog/walmart-sales", target: "_self", primary: true },
      { text: "Tableau Dashboard", url: "https://public.tableau.com/app/profile/aaron.villegas3123/viz/WalmartSalesAnalysis_17802549747750/KPIDashboard", target: "_blank" },
      { text: "GitHub", url: "https://github.com/AaronVillegas5/walmart_data_analysis", target: "_blank" }
    ]}
  />
  <div class="divider my-0"></div>

  <!-- 2. Multi-Echelon Replenishment & Stockout Risk Simulator -->
  <HorizontalCard
    title="Multi-Echelon Replenishment & Stockout Risk Simulator"
    desc="Interactive supply chain simulator that models safety stock, reorder points, and lead-time variability across 50,000+ orders. Uses DuckDB for sub-second local SQL queries without database overhead, SciPy Monte Carlo simulations to calculate stockout risks under demand spikes, and Streamlit/Plotly for scenario testing."
    url="https://github.com/AaronVillegas5/supply-chain-replenishment-simulator"
    badge="Inventory Analytics"
    tags={["Python", "DuckDB", "SciPy", "Streamlit", "Plotly", "Monte Carlo"]}
    custom_links={[
      { text: "GitHub", url: "https://github.com/AaronVillegas5/supply-chain-replenishment-simulator", target: "_blank" }
    ]}
  />
  <div class="divider my-0"></div>

  <!-- 3. Macroeconomic & Climate Analytics Platform (Macro Data Pipeline) -->
  <HorizontalCard
    title="Macroeconomic & Climate Analytics Platform (Macro Data Pipeline)"
    img="/macro-pipeline.webp"
    desc="Data platform that ingests 9M+ time-series records from FRED, Open-Meteo, and US Census Retail APIs into PostgreSQL and BigQuery. Orchestrated daily with Apache Airflow in Docker and modeled in BigQuery with dbt. Features a SARIMAX forecasting engine for retail trends and a FastAPI backend with a Gemini agent that writes and runs BigQuery SQL queries from plain-English questions."
    url="/blog/macro-data-pipeline"
    badge="Data Engineering"
    tags={["Python", "Apache Airflow", "dbt", "BigQuery", "Snowflake", "PostgreSQL", "Docker", "FastAPI", "SARIMAX"]}
    custom_links={[
      { text: "Read Case Study", url: "/blog/macro-data-pipeline", target: "_self", primary: true },
      { text: "GitHub", url: "https://github.com/AaronVillegas5/macro-data-pipeline", target: "_blank" }
    ]}
  />
  <div class="divider my-0"></div>

  <!-- 4. The Frontier Brief -->
  <HorizontalCard
    title="The Frontier Brief: Daily AI Intelligence Pipeline"
    desc="A daily AI briefing I built and run. Every morning it pulls from AI lab blogs, Reddit, Hacker News, Mastodon and GitHub Trending, ranks what matters, and drafts the newsletter with a writer model. A second model reviews the draft, and plain code checks catch repeated wording and mismatched names before it goes out. Each edition is emailed through Buttondown and saved to a public archive. It runs on GitHub Actions for about 30 cents a day, retries on failure, alerts me if a day is missed, and has 440+ tests."
    url="https://aaronvillegas5.github.io/frontier-brief/"
    badge="Autonomous Pipeline"
    tags={["Python", "OpenAI API", "GitHub Actions", "Buttondown", "Supabase", "pytest"]}
    custom_links={[
      { text: "Read the Latest Edition", url: "https://aaronvillegas5.github.io/frontier-brief/", target: "_blank", primary: true }
    ]}
  />
  <div class="divider my-0"></div>

  <!-- 5. Environmental Health Risk Mapping Platform -->
  <HorizontalCard
    title="Environmental Health Risk Mapping Platform"
    img="/env-risk-map.webp"
    desc="Won 1st Place for Best Visualization out of 39 teams. Blended CalEnviroScreen, EPA, and census data across 700+ California ZIP codes into a composite Health Vulnerability Index. Trained XGBoost models to predict respiratory and cardiac risk factors, deployed behind a FastAPI service for real-time risk scores."
    url="/blog/environmental-health-risk-map"
    badge="Datathon Winner"
    tags={["Python", "XGBoost", "FastAPI", "Spatial Analysis", "Machine Learning"]}
    custom_links={[
      { text: "Read Case Study", url: "/blog/environmental-health-risk-map", target: "_self", primary: true },
      { text: "Live Demo", url: "https://environmental-health-risk-map.vercel.app", target: "_blank" },
      { text: "GitHub", url: "https://github.com/AaronVillegas5/environmental-health-risk-map", target: "_blank" }
    ]}
  />
  <div class="divider my-0"></div>

  <!-- 6. A/B Testing Analysis -->
  <HorizontalCard
    title="A/B Testing Analysis of Digital Marketing Campaigns"
    img="/ab-testing.webp"
    desc="Statistical hypothesis testing on 588,000+ customer records. Used unequal-group power analysis and two-proportion z-tests to measure conversion differences, validating a statistically significant 0.7% conversion lift (p < 0.05) to guide advertising spend."
    url="/blog/ab-test-marketing-campaign"
    badge="A/B Testing"
    tags={["Python", "statsmodels", "A/B Testing", "Hypothesis Testing", "Pandas", "Seaborn"]}
    custom_links={[
      { text: "Read Case Study", url: "/blog/ab-test-marketing-campaign", target: "_self", primary: true },
      { text: "GitHub", url: "https://github.com/AaronVillegas5/ABTest-MarketingCampaign", target: "_blank" }
    ]}
  />

  {
    last_posts.length > 0 && (
      <>
        <div>
          <div class="text-3xl w-full font-bold mb-5 mt-10">Deep Dives & Case Studies</div>
        </div>

        {last_posts.map((post) => (
          <>
            <HorizontalCard
              title={post.data.title}
              img={post.data.heroImage}
              desc={post.data.description}
              url={"/blog/" + createSlug(post.data.title, post.slug)}
              target="_self"
              badge={post.data.badge}
            />
            <div class="divider my-0" />
          </>
        ))}
      </>
    )
  }
</BaseLayout>
