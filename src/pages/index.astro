---
// Home page layout
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && !post.slug.startsWith("post"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1 font-medium">Hello! </div>
    <div class="text-5xl font-bold">I'm Aaron Kyle Villegas</div>
    <div class="text-2xl md:text-3xl py-3 font-bold text-primary leading-snug">
      Data Analyst & Quantitative Modeler | Applied Mathematics, ETL Pipelines & Business Intelligence
    </div>
    <div class="py-2">
      <p class="text-lg leading-relaxed">
        Applied Mathematics graduate based in Bentonville, Arkansas specializing in data science, predictive modeling, machine learning, and statistical analysis. Experienced in building automated ETL pipelines, financial risk models, and interactive analytics dashboards.
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="btn btn-primary" href="/Resume.pdf" target="_blank" rel="noopener noreferrer">
        📄 View Resume
      </a>
      <a class="btn btn-outline" href="https://linkedin.com/in/aaronvillegas1" target="_blank" rel="noopener noreferrer">
        💼 LinkedIn
      </a>
      <a class="btn btn-outline" href="https://github.com/AaronVillegas5" target="_blank" rel="noopener noreferrer">
        🐙 GitHub
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Featured Projects</div>
  </div>

  <!-- 1. Walmart Sales & Demand Analytics -->
  <HorizontalCard
    title="Walmart Sales & Demand Analytics"
    img="/walmart-analytics.webp"
    desc="Automated reporting and analytics pipelines evaluating business KPIs across retail locations. Uncovered a 69% holiday sales lift and evaluated store-level demand volatility using Coefficient of Variation (CV) for inventory planning."
    url="/blog/walmart-sales"
    badge="Data Analytics"
    tags={["Python", "SQL", "Tableau", "Pandas", "Demand Planning"]}
    custom_links={[
      { text: "📖 Read Case Study", url: "/blog/walmart-sales", target: "_self", primary: true },
      { text: "📊 Tableau Dashboard", url: "https://public.tableau.com/app/profile/aaron.villegas3123/viz/WalmartSalesAnalysis_17802549747750/KPIDashboard", target: "_blank" },
      { text: "💻 GitHub", url: "https://github.com/AaronVillegas5/walmart_data_analysis", target: "_blank" }
    ]}
  />
  <div class="divider my-0"></div>

  <!-- 2. Environmental Health Risk Mapping Platform -->
  <HorizontalCard
    title="Environmental Health Risk Mapping Platform"
    img="/env-risk-map.webp"
    desc="Datathon Winner (Best Visualization out of 39 teams). Engineered a Health Vulnerability Index (HVI) using XGBoost and 10-fold cross-validation across 700+ ZIP codes, backed by a real-time FastAPI inference engine."
    url="/blog/environmental-health-risk-map"
    badge="Datathon Winner"
    tags={["Python", "XGBoost", "FastAPI", "Spatial Analysis", "Machine Learning"]}
    custom_links={[
      { text: "📖 Read Case Study", url: "/blog/environmental-health-risk-map", target: "_self", primary: true },
      { text: "🌐 Live Demo", url: "https://environmental-health-risk-map.vercel.app", target: "_blank" },
      { text: "💻 GitHub", url: "https://github.com/AaronVillegas5/environmental-health-risk-map", target: "_blank" }
    ]}
  />
  <div class="divider my-0"></div>

  <!-- 3. Macroeconomic Time-Series Data Pipeline -->
  <HorizontalCard
    title="Macroeconomic Time-Series Data Pipeline"
    img="/macro-pipeline.webp"
    desc="Multi-source time-series ETL pipeline ingesting macroeconomic and weather APIs (FRED, Open-Meteo) into PostgreSQL, BigQuery, and Snowflake with raw API response persistence to AWS S3 for auditability."
    url="/blog/macro-data-pipeline"
    badge="Data Engineering"
    tags={["Python", "PostgreSQL", "BigQuery", "Snowflake", "AWS S3", "REST APIs"]}
    custom_links={[
      { text: "📖 Read Case Study", url: "/blog/macro-data-pipeline", target: "_self", primary: true },
      { text: "💻 GitHub", url: "https://github.com/AaronVillegas5/macro-data-pipeline", target: "_blank" }
    ]}
  />
  <div class="divider my-0"></div>

  <!-- 4. A/B Testing Analysis -->
  <HorizontalCard
    title="A/B Testing Analysis of Digital Marketing Campaigns"
    img="/ab-testing.webp"
    desc="Statistical hypothesis testing on a 588K-user marketing dataset. Executed sample size validation via unequal-group power analysis and two-proportion z-tests, confirming a statistically significant 0.7% conversion lift (p < 0.05)."
    url="/blog/ab-test-marketing-campaign"
    badge="A/B Testing"
    tags={["Python", "statsmodels", "A/B Testing", "Hypothesis Testing", "Pandas"]}
    custom_links={[
      { text: "📖 Read Case Study", url: "/blog/ab-test-marketing-campaign", target: "_self", primary: true },
      { text: "💻 GitHub", url: "https://github.com/AaronVillegas5/ABTest-MarketingCampaign", target: "_blank" }
    ]}
  />

  {
    last_posts.length > 0 && (
      <>
        <div>
          <div class="text-3xl w-full font-bold mb-5 mt-10">Deep Dives & Case Studies</div>
        </div>

        {last_posts.map((post) => (
          <>
            <HorizontalCard
              title={post.data.title}
              img={post.data.heroImage}
              desc={post.data.description}
              url={"/blog/" + createSlug(post.data.title, post.slug)}
              target="_self"
              badge={post.data.badge}
            />
            <div class="divider my-0" />
          </>
        ))}
      </>
    )
  }
</BaseLayout>
